{
  "dependencies": {
    "animate.css": "^4.1.1",
    "electron": "^37.1.0",
    "electron-store": "^10.1.0",
    "openai": "^5.9.0",
    "sass": "^1.89.2",
    "unplugin-vue-components": "^28.8.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "winston": "^3.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.2.0",
    "jsdom": "^25.0.0",
    "naive-ui": "^2.42.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.27.0",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^2.1.0"
  },
  "main": "dist/src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:ts\" \"npm run dev:electron\" \"npm run dev:vite\"",
    "dev:electron": "electron .",
    "dev:vite": "vite",
    "dev:ts": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "typedoc",
    "docs:serve": "cd docs-generated && python -m http.server 8889",
    "docs:build": "npm run docs:generate"
  }
